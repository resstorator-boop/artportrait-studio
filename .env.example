# Database (Neon / Supabase / any Postgres)
DATABASE_URL=postgresql://user:password@host:5432/artportrait

# Clerk Auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SECRET=whsec_...

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Credit Pack Price IDs (create in Stripe Dashboard → Products)
STRIPE_PRICE_STARTER=price_...   # 50 credits
STRIPE_PRICE_PRO=price_...       # 150 credits
STRIPE_PRICE_STUDIO=price_...    # 500 credits

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=artportrait-assets
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# AI Generation
# "mock" — local/CI, no API key needed, returns placeholder image
# "replicate" — production (implement lib/ai/provider.ts generateReal)
AI_PROVIDER=mock
REPLICATE_API_TOKEN=r8_...

# Resend
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@artportrait.studio

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
