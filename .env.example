# =============================================================================
# NUMERO — .env.example
# Скопируй в .env.local и заполни реальными значениями.
# Никогда не коммить .env.local
# =============================================================================

# --- Neon Postgres ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Clerk ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
# Magic link sign-in tokens
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Robokassa ---
ROBOKASSA_MERCHANT_LOGIN=your_merchant_login
ROBOKASSA_PASSWORD1=your_password1
ROBOKASSA_PASSWORD2=your_password2
ROBOKASSA_TEST_MODE=true
# Result URL (webhook): https://numero.art/api/webhooks/robokassa/result
# Success URL:          https://numero.art/api/webhooks/robokassa/success

# --- Cloudflare R2 ---
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=numero-portraits
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# --- Unisender Go (email) ---
UNISENDER_GO_API_KEY=your_api_key
UNISENDER_GO_FROM_EMAIL=noreply@numero.art
UNISENDER_GO_FROM_NAME=NUMERO

# --- fal.ai (Flux генерация) ---
FAL_KEY=your_fal_key

# --- Anthropic (Claude Vision) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Inngest ---
INNGEST_EVENT_KEY=your_event_key
INNGEST_SIGNING_KEY=your_signing_key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
